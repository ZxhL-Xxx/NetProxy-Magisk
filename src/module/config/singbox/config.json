{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing-next/docs/schema.json",
  "log": {
    "disabled": false,
    "level": "info",
    "output": "stderr",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/data/adb/modules/netproxy/config/singbox/cache.db"
    },
    "clash_api": {
      "default_mode": "Rule",
      "external_controller": "127.0.0.1:9999",
      "secret": "singbox"
    },
    "urltest_unified_delay": true
  },
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 9090,
      "secret": "singbox",
      "dashboard": {
        "enabled": true,
        "path": "/data/adb/modules/netproxy/webroot/sing-box-dashboard",
        "http_client": "s-download"
      }
    }
  ],
  "http_clients": [
    {
      "tag": "s-download",
      "detour": "Proxy"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "dns-proxy",
        "type": "udp",
        "server": "127.0.0.1",
        "server_port": 5591,
        "detour": "agh-proxy-link"
      },
      {
        "tag": "dns-direct",
        "type": "udp",
        "server": "127.0.0.1",
        "server_port": 5591,
        "detour": "agh-direct-link"
      },
      {
        "tag": "dns-bootstrap",
        "type": "group",
        "servers": [
          "bootstrap-ali",
          "bootstrap-tencent"
        ]
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ],
          "doh.pub": [
            "120.53.53.53",
            "1.12.12.12"
          ]
        }
      },
      {
        "tag": "bootstrap-ali",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "tag": "bootstrap-tencent",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "dns-direct"
      },
      {
        "clash_mode": "Proxy",
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "rule_set": [
          "geosite/steam@cn",
          "geosite/microsoft@cn",
          "geosite/google@cn",
          "geosite/apple-cn"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "geosite/openai",
          "geosite/steam",
          "geosite/youtube",
          "geosite/telegram",
          "geosite/github",
          "geosite/microsoft",
          "geosite/google"
        ],
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "rule_set": "geosite/cn",
        "action": "route",
        "server": "dns-direct"
      }
    ],
    "final": "dns-proxy",
    "strategy": "prefer_ipv4",
    "disable_cache": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7080
    }
  ],
  "route": {
    "default_domain_resolver": "dns-bootstrap",
    "rule_set": [
      {
        "type": "local",
        "tag": [
          "direct",
          "proxy"
        ],
        "format": "source",
        "path": "./rules/local/{tag}.json"
      },
      {
        "type": "remote",
        "tag": [
          "geosite/openai",
          "geosite/steam",
          "geosite/youtube",
          "geosite/telegram",
          "geosite/github",
          "geosite/microsoft",
          "geosite/google",
          "geosite/steam@cn",
          "geosite/microsoft@cn",
          "geosite/google@cn",
          "geosite/apple-cn",
          "geosite/cn",
          "geosite/geolocation-!cn",
          "geoip/cn",
          "geoip/telegram"
        ],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/{tag}.srs",
        "update_interval": "24h",
        "path": "./rules/remote/{tag}.srs",
        "http_client": "s-download"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_cidr": [
          "1.1.1.1/32",
          "8.8.8.8/32"
        ],
        "port": 443,
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "ip_cidr": [
          "223.5.5.5/32",
          "223.6.6.6/32",
          "1.12.12.12/32",
          "120.53.53.53/32"
        ],
        "port": 443,
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Proxy",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": "proxy",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": "direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite/steam@cn",
          "geosite/microsoft@cn",
          "geosite/google@cn",
          "geosite/apple-cn"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite/openai"
        ],
        "action": "route",
        "outbound": "OpenAI"
      },
      {
        "rule_set": [
          "geosite/steam"
        ],
        "action": "route",
        "outbound": "Steam"
      },
      {
        "rule_set": [
          "geosite/youtube"
        ],
        "action": "route",
        "outbound": "YouTube"
      },
      {
        "rule_set": [
          "geosite/telegram",
          "geoip/telegram"
        ],
        "action": "route",
        "outbound": "Telegram"
      },
      {
        "rule_set": [
          "geosite/github"
        ],
        "action": "route",
        "outbound": "GitHub"
      },
      {
        "rule_set": [
          "geosite/microsoft"
        ],
        "action": "route",
        "outbound": "Microsoft"
      },
      {
        "rule_set": [
          "geosite/google"
        ],
        "action": "route",
        "outbound": "Google"
      },
      {
        "rule_set": "geosite/cn",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "geosite/geolocation-!cn",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "action": "resolve",
        "match_only": true,
        "server": "dns-proxy"
      },
      {
        "rule_set": "geoip/cn",
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      }
    ],
    "find_process": true,
    "auto_detect_interface": true,
    "final": "Proxy"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "agh-proxy-link",
      "inet4_bind_address": "127.0.0.2"
    },
    {
      "type": "direct",
      "tag": "agh-direct-link",
      "inet4_bind_address": "127.0.0.3"
    },
    {
      "type": "selector",
      "tag": "All Proxies",
      "outbounds": [
        "Proxy"
      ],
      "default": "Proxy",
      "use_all_providers": true,
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "OpenAI",
      "outbounds": [
        "Proxy",
        "All Proxies",
        "direct"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Steam",
      "outbounds": [
        "Proxy",
        "All Proxies",
        "direct"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "YouTube",
      "outbounds": [
        "Proxy",
        "All Proxies",
        "direct"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Telegram",
      "outbounds": [
        "Proxy",
        "All Proxies",
        "direct"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "GitHub",
      "outbounds": [
        "Proxy",
        "All Proxies",
        "direct"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Microsoft",
      "outbounds": [
        "Proxy",
        "All Proxies",
        "direct"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Google",
      "outbounds": [
        "Proxy",
        "All Proxies",
        "direct"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    }
  ]
}
