{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing-next/docs/schema.json",
  "log": {
    "disabled": false,
    "level": "info",
    "output": "stderr",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/data/adb/modules/netproxy/config/singbox/cache.db"
    },
    "clash_api": {
      "default_mode": "Rule",
      "external_controller": "127.0.0.1:9999",
      "secret": "singbox"
    },
    "urltest_unified_delay": true
  },
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 9090,
      "secret": "singbox",
      "dashboard": {
        "enabled": true,
        "path": "/data/adb/modules/netproxy/webroot/sing-box-dashboard",
        "http_client": "s-download"
      }
    }
  ],
  "http_clients": [
    {
      "tag": "s-download",
      "detour": "Proxy"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "dns-proxy",
        "type": "udp",
        "server": "127.0.0.1",
        "server_port": 5591,
        "detour": "agh-proxy-link"
      },
      {
        "tag": "dns-direct",
        "type": "udp",
        "server": "127.0.0.1",
        "server_port": 5591,
        "detour": "agh-direct-link"
      },
      {
        "tag": "dns-bootstrap",
        "type": "group",
        "servers": [
          "bootstrap-ali",
          "bootstrap-tencent"
        ]
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ],
          "doh.pub": [
            "120.53.53.53",
            "1.12.12.12"
          ]
        }
      },
      {
        "tag": "bootstrap-ali",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "tag": "bootstrap-tencent",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "dns-direct"
      },
      {
        "clash_mode": "Proxy",
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "rule_set": [
          "geosite-steam@cn",
          "geosite-apple@cn",
          "geosite-microsoft@cn",
          "geosite-google@cn",
          "geosite-cn"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "geosite-steam",
          "geosite-apple",
          "geosite-microsoft",
          "geosite-telegram",
          "geosite-tiktok",
          "geosite-youtube",
          "geosite-google",
          "geosite-googlefcm",
          "geosite-openai",
          "geosite-github",
          "geosite-twitter"
        ],
        "action": "route",
        "server": "dns-proxy"
      }
    ],
    "final": "dns-proxy",
    "strategy": "prefer_ipv4",
    "disable_cache": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7080
    }
  ],
  "route": {
    "default_domain_resolver": "dns-bootstrap",
    "rule_set": [
      {
        "type": "local",
        "tag": [
          "direct",
          "proxy"
        ],
        "format": "source",
        "path": "./rules/local/{tag}.json"
      },
      {
        "type": "remote",
        "tag": [
          "geosite-steam",
          "geosite-apple",
          "geosite-microsoft",
          "geosite-telegram",
          "geosite-tiktok",
          "geosite-youtube",
          "geosite-google",
          "geosite-googlefcm",
          "geosite-openai",
          "geosite-github",
          "geosite-twitter",
          "geosite-steam@cn",
          "geosite-apple@cn",
          "geosite-microsoft@cn",
          "geosite-google@cn",
          "geosite-cn",
          "geosite-geolocation-!cn",
          "geosite-category-stun"
        ],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs",
        "update_interval": "24h",
        "path": "./rules/remote/sagernet/{tag}.srs",
        "http_client": "s-download"
      },
      {
        "type": "remote",
        "tag": [
          "geoip-cn"
        ],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/{tag}.srs",
        "update_interval": "24h",
        "path": "./rules/remote/sagernet/{tag}.srs",
        "http_client": "s-download"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "dns",
          "stun"
        ],
        "timeout": "300ms"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_cidr": [
          "1.1.1.1/32",
          "8.8.8.8/32"
        ],
        "port": 443,
        "action": "route",
        "outbound": "总模式"
      },
      {
        "ip_cidr": [
          "223.5.5.5/32",
          "223.6.6.6/32",
          "1.12.12.12/32",
          "120.53.53.53/32"
        ],
        "port": 443,
        "action": "route",
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "stun"
          },
          {
            "rule_set": "geosite-category-stun"
          },
          {
            "port": [
              3478,
              5349
            ]
          },
          {
            "port_range": [
              "19302:19309"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "action": "resolve"
      },
      {
        "clash_mode": "Proxy",
        "action": "route",
        "outbound": "总模式"
      },
      {
        "rule_set": "proxy",
        "action": "route",
        "outbound": "总模式"
      },
      {
        "rule_set": "direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-steam@cn",
          "geosite-apple@cn",
          "geosite-microsoft@cn",
          "geosite-google@cn",
          "geosite-cn"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "geoip-cn",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-googlefcm"
        ],
        "action": "route",
        "outbound": "GoogleFCM"
      },
      {
        "rule_set": [
          "geosite-youtube"
        ],
        "action": "route",
        "outbound": "YouTube"
      },
      {
        "rule_set": [
          "geosite-google"
        ],
        "action": "route",
        "outbound": "Google"
      },
      {
        "rule_set": [
          "geosite-steam"
        ],
        "action": "route",
        "outbound": "Steam"
      },
      {
        "rule_set": [
          "geosite-github"
        ],
        "action": "route",
        "outbound": "GitHub"
      },
      {
        "rule_set": [
          "geosite-tiktok"
        ],
        "action": "route",
        "outbound": "TikTok"
      },
      {
        "rule_set": [
          "geosite-twitter"
        ],
        "action": "route",
        "outbound": "Twitter(X)"
      },
      {
        "rule_set": [
          "geosite-openai"
        ],
        "action": "route",
        "outbound": "OpenAI"
      },
      {
        "rule_set": [
          "geosite-apple"
        ],
        "action": "route",
        "outbound": "Apple"
      },
      {
        "rule_set": [
          "geosite-microsoft"
        ],
        "action": "route",
        "outbound": "Microsoft"
      },
      {
        "rule_set": [
          "geosite-telegram"
        ],
        "action": "route",
        "outbound": "Telegram"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "action": "route",
        "outbound": "总模式"
      },
      {
        "clash_mode": "Rule",
        "action": "route",
        "outbound": "漏网之鱼"
      }
    ],
    "find_process": true,
    "auto_detect_interface": true,
    "final": "漏网之鱼"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "agh-proxy-link",
      "inet4_bind_address": "127.0.0.2"
    },
    {
      "type": "direct",
      "tag": "agh-direct-link",
      "inet4_bind_address": "127.0.0.3"
    },
    {
      "type": "selector",
      "tag": "总模式",
      "outbounds": [
        "Proxy",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Steam",
      "outbounds": [
        "总模式",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies",
        "direct"
      ],
      "default": "总模式",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Apple",
      "outbounds": [
        "总模式",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies",
        "direct"
      ],
      "default": "总模式",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Microsoft",
      "outbounds": [
        "总模式",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies",
        "direct"
      ],
      "default": "总模式",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Telegram",
      "outbounds": [
        "总模式",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies",
        "direct"
      ],
      "default": "总模式",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "TikTok",
      "outbounds": [
        "总模式",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies",
        "direct"
      ],
      "default": "总模式",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "YouTube",
      "outbounds": [
        "总模式",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies",
        "direct"
      ],
      "default": "总模式",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Google",
      "outbounds": [
        "总模式",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies",
        "direct"
      ],
      "default": "总模式",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "GoogleFCM",
      "outbounds": [
        "总模式",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies",
        "direct"
      ],
      "default": "总模式",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "OpenAI",
      "outbounds": [
        "总模式",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies",
        "direct"
      ],
      "default": "总模式",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "GitHub",
      "outbounds": [
        "总模式",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies",
        "direct"
      ],
      "default": "总模式",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Twitter(X)",
      "outbounds": [
        "总模式",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies",
        "direct"
      ],
      "default": "总模式",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "漏网之鱼",
      "outbounds": [
        "总模式",
        "香港",
        "台湾",
        "日本",
        "美国",
        "新加坡",
        "其他地区",
        "All Proxies",
        "direct"
      ],
      "default": "总模式",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "香港",
      "outbounds": [
        "Proxy"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true,
      "use_all_providers": true,
      "include": "(?i)香港|港|hong[ _-]?kong|\\bhk\\b|🇭🇰"
    },
    {
      "type": "selector",
      "tag": "台湾",
      "outbounds": [
        "Proxy"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true,
      "use_all_providers": true,
      "include": "(?i)台湾|台灣|台北|台中|taiwan|taipei|\\btw\\b|🇹🇼"
    },
    {
      "type": "selector",
      "tag": "日本",
      "outbounds": [
        "Proxy"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true,
      "use_all_providers": true,
      "include": "(?i)日本|东京|東京|大阪|japan|tokyo|osaka|\\bjp\\b|🇯🇵"
    },
    {
      "type": "selector",
      "tag": "美国",
      "outbounds": [
        "Proxy"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true,
      "use_all_providers": true,
      "include": "(?i)美国|美國|美西|美东|洛杉矶|硅谷|西雅图|纽约|united[ _-]?states|america|los[ _-]?angeles|seattle|new[ _-]?york|\\bus\\b|\\busa\\b|🇺🇸"
    },
    {
      "type": "selector",
      "tag": "新加坡",
      "outbounds": [
        "Proxy"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true,
      "use_all_providers": true,
      "include": "(?i)新加坡|狮城|獅城|singapore|\\bsg\\b|🇸🇬"
    },
    {
      "type": "selector",
      "tag": "其他地区",
      "outbounds": [
        "Proxy"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true,
      "use_all_providers": true,
      "exclude": "(?i)(?:香港|港|hong[ _-]?kong|\\bhk\\b|🇭🇰)|(?:台湾|台灣|台北|台中|taiwan|taipei|\\btw\\b|🇹🇼)|(?:日本|东京|東京|大阪|japan|tokyo|osaka|\\bjp\\b|🇯🇵)|(?:美国|美國|美西|美东|洛杉矶|硅谷|西雅图|纽约|united[ _-]?states|america|los[ _-]?angeles|seattle|new[ _-]?york|\\bus\\b|\\busa\\b|🇺🇸)|(?:新加坡|狮城|獅城|singapore|\\bsg\\b|🇸🇬)"
    },
    {
      "type": "selector",
      "tag": "All Proxies",
      "outbounds": [
        "Proxy"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true,
      "use_all_providers": true
    }
  ]
}
